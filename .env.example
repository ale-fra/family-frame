# Optional local settings. Copy to .env; never upload real credentials or feeds.
# Use synthetic data when sharing the project.
# FRAME_CALENDAR_SOURCES_FILE=./data/calendar-sources.json
# FRAME_CALENDAR_ICS_URL=https://example.com/demo-calendar.ics
FRAME_CALENDAR_CACHE_SECONDS=900
# Port of the server. Existing installations can keep using FRAME_PHOTO_SERVER_PORT.
# FRAME_SERVER_PORT=8787
# FRAME_CONFIG_FILE=./data/frame.config.device.json
# Language and date format of the frame and admin: it-IT (default), it, en-GB, en-US, en.
# FRAME_LOCALE=it-IT
# Time zone of routine times; set it when the host runs in UTC.
# FRAME_TIMEZONE=Europe/Rome
# Seconds a finished timer / due routine stays on screen (timers: 0 = until cancelled).
# FRAME_TIMER_AUTO_DISMISS_SECONDS=60
# FRAME_ROUTINE_AUTO_DISMISS_SECONDS=60
# Default countdown style for new timers / routines: disc, sweets, journey or clock (overridable per item).
# FRAME_TIMER_STYLE=disc
# FRAME_ROUTINE_STYLE=clock
# Optional webhook for timer.created, timer.finished, routine.upcoming and routine.due events (e.g. to play a sound).
# FRAME_SCHEDULE_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/YOUR_WEBHOOK_ID
# FRAME_SCHEDULE_WEBHOOK_SECRET=YOUR_SHARED_SECRET
# Interactive API docs at /api/docs (unlocked with the admin PIN, when configured). Set to false to turn them off.
# FRAME_API_DOCS=true
# Protects /api/admin (6+ characters recommended). Empty = open. Integrations: npm run token -- create <name>
# FRAME_ADMIN_PIN=YOUR_ADMIN_PIN_HERE
# FRAME_TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# FRAME_TELEGRAM_ALLOWED_CHAT_IDS=YOUR_CHAT_ID_HERE
