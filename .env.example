# Copy this file to .env on the frame machine.
# Prefer the JSON sources file for multiple calendars with readable labels.
FRAME_CALENDAR_SOURCES_FILE=/home/alessandro/Code/frame/data/calendar-sources.json

# Legacy single-calendar fallback.
# FRAME_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/example%40group.calendar.google.com/private-example/basic.ics

# Optional: cache the remote calendar feed for this many seconds.
FRAME_CALENDAR_CACHE_SECONDS=900
