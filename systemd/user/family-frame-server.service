[Unit]
Description=Family Frame local photo and app server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alessandro/Code/frame
ExecStartPre=-/usr/bin/env bash scripts/update-and-build.sh
ExecStart=/usr/bin/env npm run server
Restart=always
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=-%h/.config/family-frame/server.env
Environment=PATH=/home/alessandro/.config/nvm/versions/node/v24.15.0/bin:/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
