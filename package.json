{
  "name": "family-frame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --disable-warning=ExperimentalWarning server/frame-server.mjs",
    "token": "node --disable-warning=ExperimentalWarning server/token-cli.mjs",
    "timer": "node --disable-warning=ExperimentalWarning server/timer-cli.mjs",
    "add-3-min-timer": "node --disable-warning=ExperimentalWarning server/timer-cli.mjs 3m \"Test timer\"",
    "generate:api-types": "node tools/generate-api-types.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "test:e2e": "vitest run --project e2e",
    "test:ui": "vitest run --project ui",
    "test:fast": "vitest run --project unit --project integration",
    "test:watch": "vitest --project unit --project integration",
    "preview": "vite preview --host 127.0.0.1",
    "export:code-behaviors": "node scripts/export-code-behaviors.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.14.0",
    "multer": "^2.1.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-easy-crop": "^5.5.7",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "swagger-ui-dist": "^5.34.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "~13.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.20.0",
    "esbuild": "^0.27.7",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.4",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
