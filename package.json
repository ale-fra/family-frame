{
  "name": "family-frame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node server/photo-server.mjs",
    "update": "bash scripts/update-and-build.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
